<Page
    x:Class="Nexora.App.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Nexora.App.Helpers"
    xmlns:controls="using:Nexora.App.Controls"
    xmlns:vm="using:Nexora.App.ViewModels"
    Background="Transparent">

    <Grid>
        <!-- Intro -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="560" Visibility="{x:Bind ViewModel.IsIntro, Mode=OneWay}">
            <controls:NexoraLogo Width="64" Height="64" HorizontalAlignment="Center" />
            <TextBlock Text="System analysis" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" Text="NEXORA checks your hardware, startup apps, background processes, power plan, gaming settings, network and Windows configuration. The scan only reads — nothing is changed." />
            <Button HorizontalAlignment="Center" Style="{StaticResource HeroButtonStyle}" Content="SCAN MY PC" Command="{x:Bind ViewModel.StartScanCommand}" />
        </StackPanel>

        <!-- Scanning -->
        <Grid Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Padding="32" ColumnSpacing="56" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid Width="280" Height="280">
                <ProgressRing Width="280" Height="280" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Opacity="0.35" />
                <controls:ScoreRing Margin="26" Thickness="10" Caption="SCANNING" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Label="{x:Bind ViewModel.CurrentStep, Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock Style="{StaticResource CardLabelStyle}" Text="NEXORA SYSTEM ANALYSIS" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanStepViewModel">
                            <Grid ColumnSpacing="12" Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource NexoraSubtleTextBrush}" Opacity="0.5" Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsActive, Mode=OneWay}" Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource NexoraGoodBrush}" Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontSize="14" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton Margin="0,12,0,0" Padding="0" Content="Cancel scan" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
        </Grid>

        <!-- Report -->
        <ScrollViewer Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
            <StackPanel helpers:Entrance.Stagger="True" Padding="32,20,32,32" Spacing="20" MaxWidth="1200">
                <Border Style="{StaticResource PurpleCardStyle}">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ScoreRing Width="200" Height="200" Value="{x:Bind ViewModel.Score, Mode=OneWay}" Label="{x:Bind ViewModel.Rating, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Style="{StaticResource CardLabelStyle}" Text="NEXORA SYSTEM ANALYSIS" />
                            <TextBlock FontSize="28" FontWeight="SemiBold">
                                <Run Text="Performance Score: " />
                                <Run Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" />
                                <Run Text="/100" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="16" Text="{x:Bind ViewModel.ImprovementsText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource BodySubtleStyle}" Text="{x:Bind ViewModel.ImpactBreakdown, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Bind ViewModel.ContinueLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ContinueCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Scan again" Command="{x:Bind ViewModel.StartScanCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Visibility="{x:Bind ViewModel.HasRecommendations, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Potential improvements" />
                                <TextBlock Style="{StaticResource BodySubtleStyle}" Text="NEXORA's advisor only pre-selects changes that make sense for your hardware. Optional items are personal preferences. Nothing is applied until you confirm." />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="Apply selected" Command="{x:Bind ViewModel.ApplySelectedCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Recommendations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecommendationViewModel">
                                    <Border Style="{StaticResource InsetStyle}" Padding="14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox MinWidth="0" VerticalAlignment="Top" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodySubtleStyle}" />
                                                <TextBlock Text="{x:Bind Benefit}" FontSize="12" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{x:Bind Current}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                                                <TextBlock Text="{x:Bind Reason}" FontSize="12" TextWrapping="WrapWholeWords" Foreground="{StaticResource NexoraAccentBrush}" />
                                                <TextBlock Text="{x:Bind Note}" FontSize="12" Foreground="{StaticResource NexoraWarningBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <TextBlock Text="{x:Bind ImpactText}" FontSize="12" />
                                                </Border>
                                                <Border Style="{StaticResource ChipStyle}">
                                                    <TextBlock Text="{x:Bind RiskText}" FontSize="12" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Findings" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Findings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FindingViewModel">
                                    <Border Style="{StaticResource InsetStyle}" Padding="14" MinHeight="84">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Top" Foreground="{x:Bind Level, Converter={StaticResource StatusBrush}}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{x:Bind Area}" Style="{StaticResource CardLabelStyle}" />
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodySubtleStyle}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
