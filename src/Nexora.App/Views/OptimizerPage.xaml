<Page
    x:Class="Nexora.App.Views.OptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Nexora.App.Helpers"
    xmlns:controls="using:Nexora.App.Controls"
    xmlns:vm="using:Nexora.App.ViewModels"
    Background="Transparent">

    <Grid Padding="32,20,32,0" RowSpacing="16" MaxWidth="1440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="16">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Optimizer" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Safe, documented Windows settings. Every change is explained, backed up first and can be undone." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="Quick optimize" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.QuickOptimizeCommand}" ToolTipService.ToolTip="Applies only low-risk changes that do not need administrator rights, after confirmation.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="Quick optimize" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeroButtonStyle}" Content="SCAN MY PC" Command="{x:Bind ViewModel.ScanCommand}" />
                </StackPanel>
            </Grid>
            <controls:BentoGrid helpers:Entrance.Stagger="True" ColumnSpacing="14" RowSpacing="14">
                    <Border controls:BentoGrid.Span="3" controls:BentoGrid.CompactSpan="6" Style="{StaticResource TealCardStyle}" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource OnColorLabelStyle}" Text="ACTIVE" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="optimizations in effect" Style="{StaticResource OnColorSubtleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardIconBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border controls:BentoGrid.Span="3" controls:BentoGrid.CompactSpan="6" Style="{StaticResource BlueCardStyle}" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource OnColorLabelStyle}" Text="AVAILABLE" />
                                <TextBlock Text="{x:Bind ViewModel.AvailableCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="can be applied now" Style="{StaticResource OnColorSubtleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardIconBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE945;" FontSize="16" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border controls:BentoGrid.Span="3" controls:BentoGrid.CompactSpan="6" Style="{StaticResource PurpleCardStyle}" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource OnColorLabelStyle}" Text="STARTUP APPS" />
                                <TextBlock Text="{x:Bind ViewModel.StartupCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="enabled at sign-in" Style="{StaticResource OnColorSubtleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardIconBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                            </Border>
                        </Grid>
                    </Border>
                    <Border controls:BentoGrid.Span="3" controls:BentoGrid.CompactSpan="6" Style="{StaticResource IndigoCardStyle}" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource OnColorLabelStyle}" Text="UNDOABLE" />
                                <TextBlock Text="{x:Bind ViewModel.UndoableCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="changes you can revert" Style="{StaticResource OnColorSubtleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardIconBadgeStyle}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                            </Border>
                        </Grid>
                    </Border>
            </controls:BentoGrid>
        </StackPanel>

        <Grid Grid.Row="1">
            <SelectorBar x:Name="Sections" SelectionChanged="OnSectionChanged">
                <SelectorBarItem Text="Optimizations" Tag="0" IsSelected="True" />
                <SelectorBarItem Text="Startup apps" Tag="1" />
                <SelectorBarItem Text="History" Tag="2" />
            </SelectorBar>
            <ProgressRing HorizontalAlignment="Right" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <!-- Category filter + summary (Optimizations section) -->
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsOptimizationsSection, Mode=OneWay}">
            <ListView
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryFilter">
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                            <TextBlock Text="{x:Bind Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Optimizations -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.IsOptimizationsSection, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Items}" Margin="0,0,0,32">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OptimizationItemViewModel">
                        <Border Style="{StaticResource GlassCardStyle}" BorderThickness="5,1,1,1" BorderBrush="{x:Bind CategoryBrush}">
                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource ChipStyle}" Padding="8,1">
                                            <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodySubtleStyle}" />
                                    <TextBlock Text="{x:Bind CurrentValue, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind Badges}" FontSize="12" Foreground="{StaticResource NexoraWarningBrush}" Visibility="{x:Bind HasBadges}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Border Style="{StaticResource ChipStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind StatusLevel, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind RiskLevel, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{x:Bind RiskText}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChipStyle}">
                                        <TextBlock Text="{x:Bind ImpactText}" FontSize="12" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                    <Border Style="{StaticResource InsetStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CardLabelStyle}" Text="WHAT IT CHANGES" />
                                                <TextBlock Text="{x:Bind WhatItChanges}" Style="{StaticResource BodyStyle}" FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CardLabelStyle}" Text="WHY IT MAY HELP" />
                                                <TextBlock Text="{x:Bind WhyItHelps}" Style="{StaticResource BodyStyle}" FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource CardLabelStyle}" Text="EXPECTED BENEFIT" />
                                                <TextBlock Text="{x:Bind ExpectedBenefit}" Style="{StaticResource BodyStyle}" FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                    <HyperlinkButton Padding="0" Content="{x:Bind DetailsLabel, Mode=OneWay}" Command="{x:Bind ToggleDetailsCommand}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Undo" Command="{x:Bind UndoCommand}" Visibility="{x:Bind CanUndo, Mode=OneWay}" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Bind ApplyLabel}" Command="{x:Bind ApplyCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Startup apps -->
        <Grid Grid.Row="2" Grid.RowSpan="2" RowSpacing="12" Visibility="{x:Bind ViewModel.IsStartupSection, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource BodySubtleStyle}" Text="Turn off apps you don't need right after signing in. NEXORA uses the same mechanism as Task Manager: entries are disabled, never deleted. Security software and Windows components are protected." />
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.StartupItems}" SelectionMode="None" Padding="0,0,0,32">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupItemViewModel">
                        <Border Style="{StaticResource GlassCardStyle}" Padding="18,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Source}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                                    <TextBlock Text="{x:Bind Command}" FontSize="11" Foreground="{ThemeResource NexoraSubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ProtectionText}" FontSize="12" Foreground="{StaticResource NexoraWarningBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="Enabled" OffContent="Disabled" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- History -->
        <Grid Grid.Row="2" Grid.RowSpan="2" RowSpacing="12" Visibility="{x:Bind ViewModel.IsHistorySection, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Style="{StaticResource BodySubtleStyle}" VerticalAlignment="Center" Text="Every change NEXORA made, with the value before and after. The newest active change of each optimization can be undone." />
                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Content="Restore previous configuration" Command="{x:Bind ViewModel.RestoreAllCommand}" />
            </Grid>
            <Grid Grid.Row="1" Padding="18,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CardLabelStyle}" Text="DATE" />
                <TextBlock Grid.Column="1" Style="{StaticResource CardLabelStyle}" Text="OPTIMIZATION" />
                <TextBlock Grid.Column="2" Style="{StaticResource CardLabelStyle}" Text="PREVIOUS VALUE" />
                <TextBlock Grid.Column="3" Style="{StaticResource CardLabelStyle}" Text="NEW VALUE" />
                <TextBlock Grid.Column="4" Style="{StaticResource CardLabelStyle}" Text="STATUS" />
            </Grid>
            <TextBlock Grid.Row="2" Text="No changes yet. Applied optimizations will appear here." Style="{StaticResource BodySubtleStyle}" Margin="18,0" Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay}" />
            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.HistoryItems}" SelectionMode="None" Padding="0,0,0,32">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Border Style="{StaticResource GlassCardStyle}" Padding="18,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Date}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind Message}" FontSize="11" Foreground="{ThemeResource NexoraSubtleTextBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind HasMessage}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind PreviousValue}" FontSize="12" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                <TextBlock Grid.Column="3" Text="{x:Bind NewValue}" FontSize="12" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind Level, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{x:Bind Status}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Free space" FontSize="12" Command="{x:Bind PurgeCommand}" Visibility="{x:Bind CanPurge}" ToolTipService.ToolTip="Permanently delete the quarantined temporary files" />
                                    <Button Content="Undo" FontSize="12" Command="{x:Bind UndoCommand}" Visibility="{x:Bind CanUndo}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
