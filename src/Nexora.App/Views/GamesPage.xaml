<Page
    x:Class="Nexora.App.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexora.App.ViewModels"
    Background="Transparent">

    <Grid Padding="32,20,32,24" RowSpacing="16" MaxWidth="1440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Games" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Installed games and per-game profiles. Launch through NEXORA to apply a profile and revert it automatically when you quit." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.DetectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="Detect games" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.AddCustomCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add game" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodySubtleStyle}" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <TextBlock Margin="12" Style="{StaticResource BodySubtleStyle}" Text="No games yet. Use Detect games or Add game." Visibility="{x:Bind ViewModel.HasNoProfiles, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Profiles}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameProfileViewModel">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource NexoraAccentSoftBrush}">
                                        <TextBlock Text="{x:Bind Initials, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}">
                                            <Run Text="{x:Bind SourceText}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind ProfileText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock Style="{StaticResource BodySubtleStyle}" Text="Select a game to edit its profile." Visibility="{x:Bind ViewModel.HasNoSelection, Mode=OneWay}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Game profile" />
                            <TextBox Header="Game name" Text="{x:Bind ViewModel.EditName, Mode=TwoWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Executable path" PlaceholderText="C:\Games\MyGame\Game.exe" Text="{x:Bind ViewModel.EditPath, Mode=TwoWay}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind ViewModel.BrowseCommand}" />
                            </Grid>
                            <TextBox Header="Launch arguments" PlaceholderText="e.g. -novid -fullscreen" Text="{x:Bind ViewModel.EditArguments, Mode=TwoWay}" />
                            <TextBox Header="Game process name (optional)" PlaceholderText="Only needed when the game starts through a launcher, e.g. VALORANT-Win64-Shipping" Text="{x:Bind ViewModel.EditProcessName, Mode=TwoWay}" />
                            <ComboBox Header="Optimization profile" MinWidth="420" ItemsSource="{x:Bind ViewModel.ProfileOptions}" SelectedItem="{x:Bind ViewModel.EditProfile, Mode=TwoWay}" />
                            <ComboBox Header="Process priority" MinWidth="240" ItemsSource="{x:Bind ViewModel.PriorityOptions}" SelectedItem="{x:Bind ViewModel.EditPriority, Mode=TwoWay}" />
                            <ToggleSwitch Header="Monitor performance (FPS) while playing" IsOn="{x:Bind ViewModel.EditMonitor, Mode=TwoWay}" />
                            <ToggleSwitch Header="Revert profile optimizations when the game closes" IsOn="{x:Bind ViewModel.EditRevert, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" Foreground="{StaticResource NexoraProblemBrush}" TextWrapping="WrapWholeWords" />
                            <TextBlock Style="{StaticResource BodySubtleStyle}" FontSize="12" Text="High priority can make the game more responsive under background load, but may slow other apps. Realtime priority is never used because it can freeze Windows." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Style="{StaticResource HeroButtonStyle}" Content="LAUNCH" Command="{x:Bind ViewModel.LaunchCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Command="{x:Bind ViewModel.DeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
