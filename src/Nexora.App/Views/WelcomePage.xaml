<Page
    x:Class="Nexora.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexora.App.Controls"
    Background="Transparent">
    <Grid>
        <Ellipse Width="620" Height="620" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF1FB6FF" />
                    <GradientStop Offset="0.55" Color="#407C6CFF" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <StackPanel x:Name="Hero" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="560">
            <controls:NexoraLogo Width="88" Height="88" HorizontalAlignment="Center" />
            <TextBlock Text="NEXORA" FontSize="44" FontWeight="SemiBold" CharacterSpacing="420" HorizontalAlignment="Center" />
            <TextBlock Text="Optimize. Measure. Dominate." FontSize="16" Foreground="{ThemeResource NexoraSubtleTextBrush}" HorizontalAlignment="Center" CharacterSpacing="40" />
            <Border Height="1" Width="80" Background="{ThemeResource NexoraDividerBrush}" Margin="0,8,0,8" />
            <TextBlock Text="Let's analyze your PC." FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                TextAlignment="Center"
                Text="NEXORA measures your CPU, GPU, memory, storage, network and Windows configuration. Nothing is changed during the scan, and nothing ever leaves your PC." />
            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource HeroButtonStyle}"
                Content="START SYSTEM SCAN"
                Command="{x:Bind ViewModel.StartCommand}" />
        </StackPanel>
    </Grid>
</Page>
