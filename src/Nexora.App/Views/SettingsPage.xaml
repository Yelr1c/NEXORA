<Page
    x:Class="Nexora.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexora.App.ViewModels"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20,32,32" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="All settings are stored locally on this PC." />
            </StackPanel>

            <!-- Appearance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Appearance" />
                    <ComboBox Header="Theme" MinWidth="260" ItemsSource="{x:Bind ViewModel.ThemeOptions}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Accent color" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Accents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentOption">
                                    <Button Width="34" Height="34" Padding="0" CornerRadius="17" Background="{x:Bind Brush}" ToolTipService.ToolTip="{x:Bind Name}" Click="OnAccentClick" Tag="{x:Bind Hex}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource BodySubtleStyle}" FontSize="12" Text="Charts and highlights update immediately; some built-in controls pick up the new accent after restarting NEXORA." />
                    </StackPanel>
                    <ToggleSwitch Header="Enable animations" IsOn="{x:Bind ViewModel.AnimationsEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="Use hardware acceleration (Mica backdrop and translucent effects)" IsOn="{x:Bind ViewModel.HardwareAcceleration, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Startup behaviour -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Startup behavior" />
                    <ToggleSwitch Header="Start NEXORA with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay}" Foreground="{StaticResource NexoraWarningBrush}" TextWrapping="WrapWholeWords" Visibility="{x:Bind ViewModel.HasStartupMessage, Mode=OneWay}" />
                    <ToggleSwitch Header="Start minimized to the notification area" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    <ToggleSwitch Header="Minimize to tray" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Keep running in the tray when the window is closed" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Notifications" />
                    <ToggleSwitch Header="Show notifications" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                    <ToggleSwitch Header="Alert me when network quality drops" IsOn="{x:Bind ViewModel.NotifyOnNetworkDegradation, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Performance monitoring -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Performance monitoring" />
                    <ComboBox Header="Update interval" MinWidth="300" ItemsSource="{x:Bind ViewModel.IntervalOptions}" SelectedItem="{x:Bind ViewModel.SelectedInterval, Mode=TwoWay}" />
                    <ToggleSwitch Header="Keep monitoring while NEXORA is in the tray" IsOn="{x:Bind ViewModel.MonitorInBackground, Mode=TwoWay}" />
                    <ToggleSwitch Header="Capture FPS from DirectX games (requires administrator)" IsOn="{x:Bind ViewModel.FpsCaptureEnabled, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource BodySubtleStyle}" FontSize="12" Text="When hidden, NEXORA samples every 5 seconds — or stops sampling entirely if background monitoring is off — to stay lightweight." />
                </StackPanel>
            </Border>

            <!-- Network monitoring -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network monitoring" />
                    <ToggleSwitch Header="Live latency monitoring" IsOn="{x:Bind ViewModel.NetworkMonitoringEnabled, Mode=TwoWay}" />
                    <ComboBox Header="Probe interval" MinWidth="300" ItemsSource="{x:Bind ViewModel.NetworkIntervalOptions}" SelectedItem="{x:Bind ViewModel.SelectedNetworkInterval, Mode=TwoWay}" />
                    <ComboBox Header="Network test length" MinWidth="300" ItemsSource="{x:Bind ViewModel.SampleOptions}" SelectedItem="{x:Bind ViewModel.SelectedSamples, Mode=TwoWay}" />
                    <TextBox Header="Latency test server (IP address)" MaxWidth="300" HorizontalAlignment="Left" Text="{x:Bind ViewModel.NetworkTarget, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource BodySubtleStyle}" FontSize="12" Text="NEXORA only sends small ICMP echo (ping) packets and DNS queries. No data about you or your PC is transmitted." />
                </StackPanel>
            </Border>

            <!-- Optimization preferences -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Optimization preferences" />
                    <ToggleSwitch Header="Always explain and confirm before applying" IsOn="{x:Bind ViewModel.ConfirmBeforeApplying, Mode=TwoWay}" />
                    <ToggleSwitch Header="If one change in a batch fails, roll back the whole batch" IsOn="{x:Bind ViewModel.RollbackBatchOnFailure, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Restore previous configuration" Command="{x:Bind ViewModel.RestoreAllCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySubtleStyle}" FontSize="12" Text="Medium-risk changes and anything run from Quick Optimize or a scan always ask for confirmation." />
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Data and logs" />
                    <TextBlock Style="{StaticResource BodySubtleStyle}" Text="{x:Bind ViewModel.LogsPath}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open logs folder" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open data folder" Command="{x:Bind ViewModel.OpenDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
