<Page
    x:Class="Nexora.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nexora.App.ViewModels"
    Background="Transparent">

    <Grid Padding="32,20,32,0" RowSpacing="14" MaxWidth="1440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Processes" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search by name or PID" QueryIcon="Find" Text="{x:Bind ViewModel.Search, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" MinWidth="140" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.Sort, Mode=TwoWay}" PlaceholderText="Sort by" />
            <CheckBox Grid.Column="2" Content="Hide protected system processes" IsChecked="{x:Bind ViewModel.HideProtected, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="2" Padding="18,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource CardLabelStyle}" Text="PROCESS" />
            <TextBlock Grid.Column="1" Style="{StaticResource CardLabelStyle}" Text="PID" />
            <TextBlock Grid.Column="2" Style="{StaticResource CardLabelStyle}" Text="CPU" />
            <TextBlock Grid.Column="3" Style="{StaticResource CardLabelStyle}" Text="MEMORY" />
            <TextBlock Grid.Column="4" Style="{StaticResource CardLabelStyle}" Text="GPU" />
            <TextBlock Grid.Column="5" Style="{StaticResource CardLabelStyle}" Text="PRIORITY" />
            <TextBlock Grid.Column="6" Style="{StaticResource CardLabelStyle}" Text="STATUS" />
        </Grid>

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" Padding="0,0,0,24">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="18,0" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessItemViewModel">
                    <Grid ColumnSpacing="12" Opacity="{x:Bind CanEnd, Converter={StaticResource EnabledOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" Visibility="{x:Bind IsProtected}" ToolTipService.ToolTip="{x:Bind ProtectionText}" />
                            <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind PidText}" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind CpuText}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind MemoryText}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind GpuText}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind PriorityText}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="{x:Bind Status}" FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind CanEnd}">
                            <DropDownButton Padding="8,4" ToolTipService.ToolTip="Set priority">
                                <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Above normal" Command="{x:Bind AboveNormalCommand}" />
                                        <MenuFlyoutItem Text="Normal" Command="{x:Bind NormalCommand}" />
                                        <MenuFlyoutItem Text="Below normal" Command="{x:Bind BelowNormalCommand}" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Padding="10,4" Content="End" FontSize="12" Command="{x:Bind EndCommand}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,24" Severity="Informational" IsOpen="True" IsClosable="True" Message="{x:Bind ViewModel.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}" />
    </Grid>
</Page>
