<Window
    x:Class="Nexora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexora.App.Controls"
    Title="NEXORA">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Solid, theme-aware background used when the Mica backdrop is disabled or unsupported. -->
        <Border x:Name="SolidBackground" Grid.RowSpan="2" Background="{ThemeResource NexoraWindowBackgroundBrush}" Visibility="Collapsed" />

        <!-- Custom title bar: brand, system identity and live status. Non-interactive (drag region). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <controls:NexoraLogo Width="24" Height="24" />
                <TextBlock Text="NEXORA" FontSize="14" FontWeight="SemiBold" CharacterSpacing="220" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="IdentityChips" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F8;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.OsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE950;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.CpuText, Mode=OneWay}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.GpuText, Mode=OneWay}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEEA0;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.RamText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource ChipStyle}" ToolTipService.ToolTip="{x:Bind Shell.SystemStatusDetail, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind Shell.SystemLevel, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="System:" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                            <Run Text="{x:Bind Shell.SystemStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}" ToolTipService.ToolTip="{x:Bind Shell.ElevationText}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource NexoraAccentBrush}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="NEXORA:" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                            <Run Text="{x:Bind Shell.AppStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="216"
            CompactModeThresholdWidth="900"
            ExpandedModeThresholdWidth="1280"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" ToolTipService.ToolTip="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance" ToolTipService.ToolTip="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="network" ToolTipService.ToolTip="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Optimizer" Tag="optimizer" ToolTipService.ToolTip="Optimizer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Games" Tag="games" ToolTipService.ToolTip="Games">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Processes" Tag="processes" ToolTipService.ToolTip="Processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about" ToolTipService.ToolTip="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
                <InfoBar
                    x:Name="ErrorBar"
                    Margin="24"
                    MaxWidth="640"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Severity="Error"
                    IsOpen="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
