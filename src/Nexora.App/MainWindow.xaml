<Window
    x:Class="Nexora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexora.App.Controls"
    Title="NEXORA">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Solid, theme-aware background used when the Mica backdrop is disabled or unsupported. -->
        <Border x:Name="SolidBackground" Grid.RowSpan="2" Background="{ThemeResource NexoraWindowBackgroundBrush}" Visibility="Collapsed" />

        <!-- Ambient light: two soft glows drifting slowly behind the UI (compositor-driven, no CPU cost). -->
        <Grid x:Name="Ambient" Grid.RowSpan="2" IsHitTestVisible="False">
            <Ellipse x:Name="OrbA" Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-320,0,0" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#381FB6FF" />
                        <GradientStop Offset="1" Color="#001FB6FF" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="OrbB" Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-360" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#307C6CFF" />
                        <GradientStop Offset="1" Color="#007C6CFF" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Custom title bar: brand, system identity and live status. Non-interactive (drag region). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <controls:NexoraLogo Width="24" Height="24" />
                <TextBlock Text="NEXORA" FontSize="14" FontWeight="SemiBold" CharacterSpacing="220" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="IdentityChips" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F8;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.OsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE950;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.CpuText, Mode=OneWay}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.GpuText, Mode=OneWay}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEEA0;" FontSize="12" Style="{StaticResource IconStyle}" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                        <TextBlock Text="{x:Bind Shell.RamText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource ChipStyle}" ToolTipService.ToolTip="{x:Bind Shell.SystemStatusDetail, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind Shell.SystemLevelBrush, Mode=OneWay}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="Load:" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                            <Run Text="{x:Bind Shell.SystemStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}" ToolTipService.ToolTip="{x:Bind Shell.ElevationText}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource NexoraAccentBrush}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="NEXORA:" Foreground="{ThemeResource NexoraSubtleTextBrush}" />
                            <Run Text="{x:Bind Shell.AppStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            OpenPaneLength="216"
            CompactModeThresholdWidth="900"
            ExpandedModeThresholdWidth="1280"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" ToolTipService.ToolTip="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance" ToolTipService.ToolTip="Performance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="network" ToolTipService.ToolTip="Network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Optimizer" Tag="optimizer" ToolTipService.ToolTip="Optimizer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Games" Tag="games" ToolTipService.ToolTip="Games">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Processes" Tag="processes" ToolTipService.ToolTip="Processes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about" ToolTipService.ToolTip="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
                <InfoBar
                    x:Name="ErrorBar"
                    Margin="24"
                    MaxWidth="640"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Severity="Error"
                    IsOpen="False" />
            </Grid>
        </NavigationView>

        <!-- Startup animation -->
        <Grid x:Name="Splash" Grid.RowSpan="2" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Background="{ThemeResource NexoraWindowBackgroundBrush}">
            <Grid.RenderTransform>
                <CompositeTransform />
            </Grid.RenderTransform>
            <Ellipse x:Name="SplashGlow" Width="520" Height="520" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#661FB6FF" />
                        <GradientStop Offset="0.5" Color="#227C6CFF" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                    <Ellipse x:Name="SplashRing" Width="150" Height="150" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FF1FB6FF" />
                                <GradientStop Offset="1" Color="#FF7C6CFF" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <CompositeTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <controls:NexoraLogo x:Name="SplashLogo" Width="100" Height="100" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <controls:NexoraLogo.RenderTransform>
                            <CompositeTransform />
                        </controls:NexoraLogo.RenderTransform>
                    </controls:NexoraLogo>
                </Grid>
                <TextBlock x:Name="SplashTitle" Text="NEXORA" FontSize="42" FontWeight="SemiBold" CharacterSpacing="600" HorizontalAlignment="Center" Opacity="0">
                    <TextBlock.RenderTransform>
                        <CompositeTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SplashTagline" Text="OPTIMIZE  ·  MEASURE  ·  DOMINATE" FontSize="12" CharacterSpacing="420" HorizontalAlignment="Center" Foreground="{ThemeResource NexoraSubtleTextBrush}" Opacity="0" />
                <Grid Width="240" Height="2" Margin="0,16,0,0" HorizontalAlignment="Center" Background="{ThemeResource NexoraChipBrush}">
                    <Rectangle x:Name="SplashBar" RenderTransformOrigin="0,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FF1FB6FF" />
                                <GradientStop Offset="1" Color="#FF7C6CFF" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <CompositeTransform ScaleX="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
