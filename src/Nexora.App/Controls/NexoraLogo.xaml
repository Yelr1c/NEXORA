<UserControl
    x:Class="Nexora.App.Controls.NexoraLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- NEXORA mark: a faceted "N" inside a rounded tile. Pure vector, legible from 16 px upwards. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Rectangle Width="64" Height="64" RadiusX="16" RadiusY="16">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1FB6FF" />
                        <GradientStop Offset="1" Color="#6A5CFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="64" Height="64" RadiusX="16" RadiusY="16" Opacity="0.35">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#66FFFFFF" />
                        <GradientStop Offset="0.5" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Left stem -->
            <Path Fill="White" Data="M17,47 L17,17 L25,17 L25,47 Z" />
            <!-- Diagonal -->
            <Path Fill="White" Data="M17,17 L25,17 L47,47 L39,47 Z" />
            <!-- Right stem (accent cut) -->
            <Path Fill="White" Opacity="0.82" Data="M39,17 L47,17 L47,40 L39,29 Z" />
        </Canvas>
    </Viewbox>
</UserControl>
