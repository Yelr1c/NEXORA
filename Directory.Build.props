<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>NEXORA</Company>
    <Product>NEXORA</Product>
    <Authors>NEXORA</Authors>
    <Copyright>© 2026 NEXORA. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <!-- Allows the Windows-specific projects to be restored/compiled from non-Windows CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>
</Project>
